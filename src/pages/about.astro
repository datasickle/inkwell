---
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import Link from "../components/Link.astro";
---

<Base title="关于" description="一个博客，随便写点东西。">
  <Container>
    <div class="animate max-w-xl">
      <img
        src="/images/avatar.png"
        alt="datasickle"
        width="256"
        height="256"
        class="size-24 rounded-full object-cover ring-1 ring-black/10 dark:ring-white/20"
      />

      <h1 class="mt-6 text-2xl font-semibold text-black dark:text-white">关于</h1>

      <p class="mt-6 text-[15px] leading-7">一个博客，随便写点东西。</p>

      <p class="mt-3 flex items-center gap-2 text-[15px] leading-7">
        <svg
          class="shrink-0 opacity-50"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="1.5" y="3" width="13" height="10" rx="1.8"></rect>
          <path d="M2 4.2 8 8.6l6-4.4"></path>
        </svg>
        <Link href="mailto:datasickle@gmail.com" underline={false}>
          datasickle@gmail.com
        </Link>
      </p>
    </div>
  </Container>
</Base>
