---
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../lib/format";
import { groupByTag } from "../lib/tags";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id)
);

const { groups } = groupByTag(posts);
---

<Base title="标签">
  <Container>
    <div class="space-y-14">
      <section class="animate space-y-2">
        <h1 class="text-2xl font-semibold text-black dark:text-white">标签</h1>
        <p class="text-sm">
          {groups.length} 个标签 · 共 {posts.length} 篇
        </p>
      </section>

      {
        groups.length === 0 ? (
          <p class="animate text-sm">
            还没有标签。在文章 frontmatter 里写 <code>tags:</code> 就有了。
          </p>
        ) : (
          <>
            <nav class="animate flex flex-wrap gap-2">
              {groups.map(({ tag, posts: list, anchor }) => (
                <a
                  href={`#${anchor}`}
                  class="rounded-full border border-black/10 px-3 py-1 text-sm transition-colors duration-300 hover:bg-black/5 dark:border-white/15 dark:hover:bg-white/5"
                >
                  {tag}
                  <span class="ml-1 text-xs opacity-40">{list.length}</span>
                </a>
              ))}
            </nav>

            <div class="space-y-12">
              {groups.map(({ tag, posts: list, anchor }) => (
                <section id={anchor} class="animate scroll-mt-28 space-y-3">
                  <h2 class="flex items-baseline gap-2 text-sm font-semibold text-black dark:text-white">
                    {tag}
                    <span class="text-xs font-normal opacity-40">
                      {list.length}
                    </span>
                  </h2>
                  <ul class="space-y-2">
                    {list.map((post) => (
                      <li class="flex items-baseline gap-3 text-sm">
                        <span class="shrink-0 tabular-nums opacity-40">
                          {formatDate(post.data.date)}
                        </span>
                        <a
                          href={`/${post.id}/`}
                          class="transition-colors duration-300 hover:text-black dark:hover:text-white"
                        >
                          {post.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          </>
        )
      }
    </div>
  </Container>
</Base>
