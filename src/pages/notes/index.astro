---
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import { getCollection } from "astro:content";
import { yearOf, fmtDayTime, isoZoned } from "../../lib/datetime";
import { excerptOf } from "../../lib/format";
import { sortNotes } from "../../lib/notes";
import site from "../../../site.json";

const label = site.notesLabel;

const notes = sortNotes(await getCollection("notes", ({ data }) => !data.draft));

// 按年分组，但年与年之间用同一套便签墙，只是插一个年份小标题
const groups: { year: number; items: typeof notes }[] = [];
for (const note of notes) {
  const year = yearOf(note.data.date);
  const last = groups[groups.length - 1];
  if (last && last.year === year) last.items.push(note);
  else groups.push({ year, items: [note] });
}
---

<Base title={label} description={`${label}：不成篇的那些，随手记在这里。`}>
  <Container>
    <div class="space-y-12">
      <section class="animate space-y-2">
        <h1 class="text-2xl font-semibold text-black dark:text-white">{label}</h1>
        <p class="text-sm">不成篇的那些，随手记在这里。</p>
      </section>

      {
        notes.length === 0 ? (
          <p class="animate text-sm">还没有{label}。想到什么，随手记一条就行。</p>
        ) : (
          groups.map((group) => (
            <section class="animate space-y-4">
              <div class="text-xs font-semibold tracking-[0.2em] opacity-50">
                {group.year}
              </div>
              <div class="notes-wall">
                {group.items.map((note) => (
                  <a
                    href={`/notes/${note.id}/`}
                    class="note-card"
                    aria-label={`${fmtDayTime(note.data.date)} 的${label}`}
                  >
                    <div class="note-date">
                      <time datetime={isoZoned(note.data.date)}>
                        {fmtDayTime(note.data.date)}
                      </time>
                    </div>
                    <p class="note-body">{excerptOf(note.body, 220)}</p>
                    {note.data.tags.length > 0 && (
                      <ul class="note-tags">
                        {note.data.tags.map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    )}
                  </a>
                ))}
              </div>
            </section>
          ))
        )
      }
    </div>
  </Container>
</Base>

<style>
  /* 两列便签墙：列内仍是时间序（CSS 多列是自上而下排的），
     手机上自然退回单列，也就退回了时间线 */
  .notes-wall {
    column-count: 1;
    column-gap: 1.25rem;
  }

  @media (min-width: 820px) {
    .notes-wall {
      column-count: 2;
    }
  }

  .note-card {
    display: block;
    break-inside: avoid;
    margin-bottom: 1.25rem;
    padding: 0.95rem 1.1rem 0.85rem;
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 12px;
    background: #fff;
    color: inherit;
    transition:
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .note-card:hover {
    border-color: rgb(0 0 0 / 0.18);
  }

  .note-date {
    font-size: 11.5px;
    letter-spacing: 0.03em;
    /* 0.45 在 #fff 上只有 ~4.0:1，小字不过 AA；0.62 约 4.9:1 */
    opacity: 0.62;
    margin-bottom: 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  .note-body {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.72;
  }

  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .note-tags li {
    font-size: 11.5px;
    opacity: 0.7;
    border: 1px solid rgb(0 0 0 / 0.1);
    border-radius: 999px;
    padding: 0.5px 8px;
  }

  :global(html.dark) .note-card {
    background: rgb(255 255 255 / 0.03);
    border-color: rgb(255 255 255 / 0.1);
  }

  :global(html.dark) .note-card:hover {
    border-color: rgb(255 255 255 / 0.22);
  }

  :global(html.dark) .note-tags li {
    border-color: rgb(255 255 255 / 0.14);
  }
</style>
