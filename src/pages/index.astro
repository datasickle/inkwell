---
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import ArrowCard from "../components/ArrowCard.astro";
import Link from "../components/Link.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { yearOf, fmtShort } from "../lib/datetime";
import { excerptOf } from "../lib/format";
import { sortNotes } from "../lib/notes";
import site from "../../site.json";

// 新的在上面。日期精确到秒后基本不会撞，真要撞了用 id 兜底，保证每次构建顺序一致
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id)
);

// 首页只露最近三条：一是别把下面的碎片区块挤到看不见，二是新读者只需要
// “这人最近在写什么”这个信号，翻旧文走 /archive/
const latest = posts.slice(0, 3);

const groups: { year: number; items: CollectionEntry<"blog">[] }[] = [];
for (const post of latest) {
  const year = yearOf(post.data.date);
  const last = groups[groups.length - 1];
  if (last && last.year === year) {
    last.items.push(post);
  } else {
    groups.push({ year, items: [post] });
  }
}

// 首页只露最近三条：多了会把文章列表的节奏打散
const notes = sortNotes(
  await getCollection("notes", ({ data }) => !data.draft)
).slice(0, 3);
---

<Base>
  <Container>
    <div class="space-y-14">
      <section class="animate space-y-2">
        <h1 class="text-2xl font-semibold text-black dark:text-white">
          最近写的
        </h1>
        <p class="text-sm">{site.description}</p>
      </section>

      {
        posts.length === 0 ? (
          <p class="animate text-sm">还没有文章。用写作台写下第一篇吧。</p>
        ) : (
          <div class="space-y-10">
            {groups.map((group) => (
              <section class="animate space-y-4">
                <div class="text-xs font-semibold tracking-[0.2em] opacity-50">
                  {group.year}
                </div>
                <ul class="flex flex-col gap-4">
                  {group.items.map((post) => (
                    <li>
                      <ArrowCard entry={post} />
                    </li>
                  ))}
                </ul>
              </section>
            ))}
            <a
              href="/posts/"
              data-astro-prefetch="viewport"
              class="group relative flex items-center justify-between py-3 px-4 pr-10 rounded-lg border border-dashed border-black/20 dark:border-white/25 text-sm transition-colors duration-300 ease-in-out hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white"
            >
              <span class="flex items-baseline gap-2">
                <span class="font-medium opacity-75">全部文章</span>
                <span class="text-xs tabular-nums opacity-40">
                  共 {posts.length} 篇
                </span>
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current opacity-50 group-hover:opacity-90"
              >
                <line
                  x1="5"
                  y1="12"
                  x2="19"
                  y2="12"
                  class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out"
                />
                <polyline
                  points="12 5 19 12 12 19"
                  class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out"
                />
              </svg>
            </a>
          </div>
        )
      }

      {
        notes.length > 0 && (
          <section class="animate space-y-3">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-xs font-semibold tracking-[0.2em] opacity-50">
                {site.notesLabel}
              </h2>
              <Link
                href="/notes/"
                prefetch="viewport"
                underline={false}
                class="text-xs opacity-55 hover:opacity-100"
              >
                全部{site.notesLabel} →
              </Link>
            </div>
            <ul class="flex flex-col divide-y divide-black/10 dark:divide-white/15">
              {notes.map((note) => (
                <li>
                  <a
                    href={`/notes/${note.id}/`}
                    class="flex items-baseline gap-4 py-3 text-sm"
                  >
                    <span class="shrink-0 tabular-nums text-xs opacity-45">
                      {fmtShort(note.data.date)}
                    </span>
                    <span class="line-clamp-1 opacity-80">
                      {excerptOf(note.body, 90)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </Container>
</Base>
