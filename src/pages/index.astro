---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { formatDay, readingTime, excerptOf } from "../lib/format";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const groups: { year: number; items: typeof posts }[] = [];
for (const post of posts) {
  const year = post.data.date.getFullYear();
  const last = groups[groups.length - 1];
  if (last && last.year === year) {
    last.items.push(post);
  } else {
    groups.push({ year, items: [post] });
  }
}
---

<Base>
  <section class="post-list">
    {
      groups.map((group) => (
        <>
          <h2 class="year-heading">{group.year}</h2>
          {group.items.map((post) => (
            <article class="post-item">
              <time datetime={post.data.date.toISOString()}>
                {formatDay(post.data.date)}
              </time>
              <div>
                <h2>
                  <a href={`/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p class="excerpt">
                  {post.data.summary || excerptOf(post.body)}
                </p>
                <div class="terms">
                  <span class="tag">{readingTime(post.body)} 分钟</span>
                  {post.data.tags.map((tag: string) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </>
      ))
    }
    {
      posts.length === 0 && (
        <p class="tagline">还没有文章。用写作 app 写下第一篇吧。</p>
      )
    }
  </section>
</Base>
