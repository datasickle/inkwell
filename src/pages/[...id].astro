---
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import FormattedDate from "../components/FormattedDate.astro";
import BackToPrev from "../components/BackToPrev.astro";
import Share from "../components/Share.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { readingTime, firstLocalImage, excerptOf } from "../lib/format";
import { fmtDate } from "../lib/datetime";
import site from "../../site.json";
import { heroImage } from "../lib/images";
import { groupByTag } from "../lib/tags";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) =>
      b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id)
  );
  // 与 /tags 共用同一份标签排序，锚点才对得上
  const { anchorOf } = groupByTag(posts);
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      tagAnchors: anchorOf,
      // 列表是「新 → 旧」，所以 i-1 是时间上更新的一篇，i+1 是更早的一篇
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  tagAnchors: Record<string, string>;
  newer: CollectionEntry<"blog"> | null;
  older: CollectionEntry<"blog"> | null;
}

const { post, tagAnchors, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, date, tags, summary } = post.data;

// 只取二三级标题；少于 2 条就不显示，免得短文的目录占地方
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// 正文有站内配图就用构建期裁的分享卡，没有则回落到全站默认那张
const firstImage = firstLocalImage(post.body);
const ogImage = firstImage ? `/og/${post.id}.png` : undefined;
// 首图（LCP 候选）提前在 <head> 里取，别等解析到正文
const preload = heroImage(firstImage);

// 分享卡片要用的文字，先在这里算好，交给浏览器画
const cardSummary = summary?.trim() || excerptOf(post.body, 160);
const shareCard = {
  title,
  // 中文之间被摘录逻辑塞进去的空格去掉，排出来才像文章
  summary: cardSummary
    .replace(/(?<=[\u4e00-\u9fff])\s+(?=[\u4e00-\u9fff])/g, "")
    .replace(/\s+/g, " "),
  date: fmtDate(date),
  tags,
  url: new URL(Astro.url.pathname, Astro.site ?? site.url).href,
  site: site.title,
  author: site.author,
  domain: new URL(site.url).host,
  image: preload?.src ?? null,
};
---

<Base
  title={title}
  description={summary}
  type="article"
  ogImage={ogImage}
  publishedTime={date.toISOString()}
  tags={tags}
  preload={preload ?? undefined}
  readingPrefs
>
  {/* 阅读进度条：固定在页头之上，宽度由脚本按正文进度缩放 */}
  <div class="read-progress" aria-hidden="true">
    <span id="read-progress-bar"></span>
  </div>

  <Container>
    <div class="animate">
      <BackToPrev href="/">全部文章</BackToPrev>
    </div>

    <div class="my-10 space-y-1">
      <div class="animate flex flex-wrap items-center gap-x-1.5 gap-y-1.5 text-sm">
        <FormattedDate date={date} />
        <span class="opacity-40" aria-hidden="true">{"·"}</span>
        <span>{readingTime(post.body)} 分钟</span>
        {
          tags.length > 0 && (
            <span class="flex flex-wrap items-center gap-1.5">
              {tags.map((tag) => (
                <a
                  href={`/tags#${tagAnchors[tag] ?? ""}`}
                  class="rounded-full border border-black/10 px-2 py-0.5 text-xs leading-5 transition-colors duration-300 opacity-75 hover:border-black/25 hover:text-black hover:opacity-100 dark:border-white/15 dark:hover:border-white/30 dark:hover:text-white"
                >
                  {tag}
                </a>
              ))}
            </span>
          )
        }
      </div>
      <h1 class="animate text-2xl sm:text-3xl font-semibold leading-snug text-black dark:text-white">
        {title}
      </h1>
    </div>

    {
      toc.length >= 2 && (
        <>
          <nav
            id="toc"
            aria-label="目录"
            class="animate toc relative mb-10 space-y-2 border-l-2 border-black/10 pl-4 text-sm dark:border-white/15"
          >
            {/* 跟随高亮的滑块，位置由脚本按当前小节移动 */}
            <span class="toc-marker" aria-hidden="true" />
            {toc.map((h) => (
              <a
                href={`#${h.slug}`}
                data-target={h.slug}
                class:list={[
                  "toc-link block leading-snug opacity-70 transition-colors duration-300 hover:text-black hover:opacity-100 dark:hover:text-white",
                  h.depth === 3 && "pl-4 text-[13px] opacity-55",
                ]}
              >
                {h.text}
              </a>
            ))}
          </nav>
          {/* 宽屏时目录被抽到右侧固定，用它补回原来的间距 */}
          <div class="toc-gap" aria-hidden="true" />
        </>
      )
    }

    <article class="animate">
      <Content />
    </article>

    <Share data={shareCard} />

    <p class="animate mt-6 text-xs leading-6 opacity-55">
      本文采用
      <a href="/license/" class="underline decoration-current/30 underline-offset-2 hover:decoration-current">CC BY-NC-SA 4.0</a>
      许可，转载请注明作者与原文链接。
    </p>

    {
      (older || newer) && (
        <nav
          aria-label="上下篇"
          class="animate mt-10 grid gap-2 border-t border-black/10 pt-8 sm:grid-cols-2 dark:border-white/15"
        >
          {older && (
            <a
              href={`/${older.id}/`}
              class="group -mx-3 rounded-lg px-3 py-3 transition-colors duration-300 hover:bg-black/5 dark:hover:bg-white/5 sm:col-start-1"
            >
              <span class="flex items-center gap-1.5 text-xs opacity-50">
                <span aria-hidden="true">←</span> 上一篇
              </span>
              <span class="mt-1.5 block text-sm font-medium leading-snug text-black/75 transition-colors group-hover:text-black dark:text-white/75 dark:group-hover:text-white">
                {older.data.title}
              </span>
              <span class="mt-1 block text-xs opacity-40">
                <FormattedDate date={older.data.date} variant="short" />
              </span>
            </a>
          )}
          {newer && (
            <a
              href={`/${newer.id}/`}
              class="group -mx-3 rounded-lg px-3 py-3 transition-colors duration-300 hover:bg-black/5 dark:hover:bg-white/5 sm:col-start-2 sm:text-right"
            >
              <span class="flex items-center gap-1.5 text-xs opacity-50 sm:justify-end">
                下一篇 <span aria-hidden="true">→</span>
              </span>
              <span class="mt-1.5 block text-sm font-medium leading-snug text-black/75 transition-colors group-hover:text-black dark:text-white/75 dark:group-hover:text-white">
                {newer.data.title}
              </span>
              <span class="mt-1 block text-xs opacity-40">
                <FormattedDate date={newer.data.date} variant="short" />
              </span>
            </a>
          )}
        </nav>
      )
    }
  </Container>

  {/*
    两处渐进增强，都用原生 DOM 实现，不引任何库：
    1) 给每个 <pre> 套一层容器并加“复制”按钮，JS 不跑就只是没有按钮，代码块本身照旧
    2) 点正文图片放大查看，Esc 或点任意处关闭
  */}
  <script>

    /* ---------- 代码块复制 ---------- */

    async function copyText(text: string) {
      // 优先用异步剪贴板 API。注意它可能「存在但被拒」：
      // 页面未聚焦、权限被策略拦、部分浏览器隐私模式下都会 reject，
      // 所以必须 try 一次再降级，不能只判断 API 存不存在。
      if (navigator.clipboard && window.isSecureContext) {
        try {
          await navigator.clipboard.writeText(text);
          return;
        } catch {
          /* 落到下面的兜底 */
        }
      }
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.cssText = "position:fixed;top:0;left:-9999px;opacity:0";
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try {
        ok = document.execCommand("copy");
      } finally {
        document.body.removeChild(ta);
      }
      if (!ok) throw new Error("copy failed");
    }

    function enhanceCodeBlocks() {
      document.querySelectorAll<HTMLPreElement>("article pre").forEach((pre) => {
        // 已经处理过就跳过，避免重复插入按钮
        if (pre.parentElement?.classList.contains("code-block")) return;

        const box = document.createElement("div");
        box.className = "code-block";
        pre.replaceWith(box);
        box.appendChild(pre);

        // Shiki 把语言写在 pre[data-language] 上，挪到外层给 CSS 当标签用。
        // 少数语言缩写看着别扭，给一个显示名；plaintext 显示出来没意义，跳过。
        const LANG_LABEL: Record<string, string> = {
          csharp: "C#",
          javascript: "JS",
          typescript: "TS",
          bash: "Shell",
          powershell: "PS",
          markdown: "MD",
          plaintext: "",
          text: "",
        };
        const raw = (pre.dataset.language ?? "").trim().toLowerCase();
        const label = raw ? (LANG_LABEL[raw] ?? raw) : "";
        if (label) box.dataset.lang = label;

        // 一两行的命令挂上行号反而碍眼，四行以上才加
        const lines = pre.querySelectorAll<HTMLElement>(".line");
        if (lines.length >= 4) box.classList.add("with-lines");

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "code-copy";
        btn.textContent = "复制";
        btn.setAttribute("aria-label", "复制这段代码");

        let timer = 0;
        btn.addEventListener("click", async () => {
          // 按行读 textContent 再拼：行号是 ::before 生成的，
          // 不在 DOM 里，但 innerText 会把它算进去，用 .line 拼最干净。
          const code = lines.length
            ? Array.from(lines, (l) => l.textContent ?? "").join("\n")
            : (pre.querySelector("code")?.textContent ?? pre.textContent ?? "");
          try {
            await copyText(code.replace(/\n$/, ""));
            btn.textContent = "已复制";
            btn.classList.add("done");
          } catch {
            btn.textContent = "失败";
          }
          clearTimeout(timer);
          timer = window.setTimeout(() => {
            btn.textContent = "复制";
            btn.classList.remove("done");
          }, 1600);
        });

        box.appendChild(btn);
      });
    }

    /* ---------- 图片放大 ---------- */

    function setupLightbox() {
      const article = document.querySelector("article");
      if (!article) return;

      let overlay: HTMLDivElement | null = null;
      let frame: HTMLImageElement | null = null;
      let counter: HTMLSpanElement | null = null;
      let items: { src: string; alt: string }[] = [];
      let index = 0;
      let scrollY = 0;

      // 缩放与拖动（滚轮放大后可以拖着看细节）
      let scale = 1;
      let tx = 0;
      let ty = 0;
      let dragging = false;
      let moved = false;
      let startX = 0;
      let startY = 0;
      let baseX = 0;
      let baseY = 0;
      // 手机上横滑翻页的起点
      let touchX = 0;
      let touchY = 0;

      const MAX_SCALE = 4;

      function collect() {
        const list: { src: string; alt: string }[] = [];
        article.querySelectorAll("img").forEach((node) => {
          const img = node as HTMLImageElement;
          // 优化过的图带 width 属性，懒加载还没落地时也能判大小；
          // 表情、图标这类小图放大没意义，直接跳过
          const declared = Number(img.getAttribute("width") ?? 0);
          if (declared >= 200 || img.naturalWidth >= 200) {
            list.push({ src: img.currentSrc || img.src, alt: img.alt });
          }
        });
        return list;
      }

      function paint() {
        if (!frame) return;
        frame.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
        frame.style.cursor = scale > 1 ? (dragging ? "grabbing" : "grab") : "zoom-in";
        overlay?.classList.toggle("zoomed", scale > 1);
      }

      function reset() {
        scale = 1;
        tx = 0;
        ty = 0;
        paint();
      }

      function show(next: number) {
        if (!items.length) return;
        index = (next + items.length) % items.length;
        if (frame) {
          frame.src = items[index].src;
          frame.alt = items[index].alt;
        }
        reset();
        if (counter) {
          counter.textContent = items.length > 1 ? `${index + 1} / ${items.length}` : "";
          counter.hidden = items.length < 2;
        }
      }

      function close() {
        if (!overlay) return;
        const root = document.documentElement;
        overlay.classList.remove("on");
        // body 一解除 fixed，文档就回到顶部；而全局是 scroll-behavior: smooth，
        // 直接 scrollTo 会变成一段「从顶部滑下来」的动画，看着像页面重新加载了一遍。
        // 这一步必须瞬时复位，所以先把 smooth 临时关掉，下一帧再还原。
        const prevBehavior = root.style.scrollBehavior;
        root.style.scrollBehavior = "auto";
        root.classList.remove("lightbox-open");
        document.body.style.top = "";
        window.scrollTo(0, scrollY);
        requestAnimationFrame(() => {
          root.style.scrollBehavior = prevBehavior;
        });
        const dying = overlay;
        overlay = null;
        frame = null;
        counter = null;
        window.setTimeout(() => dying.remove(), 220);
      }

      function openAt(list: { src: string; alt: string }[], start: number) {
        if (overlay || !list.length) return;
        items = list;
        scrollY = window.scrollY;

        overlay = document.createElement("div");
        overlay.className = "lightbox";
        overlay.setAttribute("role", "dialog");
        overlay.setAttribute("aria-modal", "true");
        overlay.setAttribute("aria-label", items[start]?.alt || "图片预览");

        frame = document.createElement("img");
        frame.alt = "";
        frame.draggable = false;
        overlay.appendChild(frame);

        counter = document.createElement("span");
        counter.className = "lightbox-count";
        overlay.appendChild(counter);

        document.body.appendChild(overlay);
        show(start);
        // 下一帧再加 .on，否则不会触发过渡
        requestAnimationFrame(() => overlay?.classList.add("on"));

        // 锁滚动：fixed + 负 top 保持视觉位置不跳
        document.documentElement.classList.add("lightbox-open");
        document.body.style.top = `-${scrollY}px`;

        overlay.addEventListener("click", (event) => {
          const target = event.target as HTMLElement;
          // 点背景关闭；没放大时点图片本身也关闭（沿用原来的手感）
          if (target === overlay) close();
          else if (target === frame && scale === 1 && !moved) close();
          moved = false;
        });

        // 滚轮缩放，1x 到 4x
        overlay.addEventListener(
          "wheel",
          (event) => {
            event.preventDefault();
            const next = Math.min(
              MAX_SCALE,
              Math.max(1, Math.round(scale * (event.deltaY < 0 ? 1.15 : 0.87) * 1000) / 1000)
            );
            if (next === scale) return;
            scale = next;
            if (scale === 1) {
              tx = 0;
              ty = 0;
            }
            paint();
          },
          { passive: false }
        );

        // 放大之后按住拖动
        overlay.addEventListener("pointerdown", (event) => {
          if (scale === 1 || !frame) return;
          dragging = true;
          moved = false;
          startX = event.clientX;
          startY = event.clientY;
          baseX = tx;
          baseY = ty;
          frame.setPointerCapture?.(event.pointerId);
          paint();
        });

        overlay.addEventListener("pointermove", (event) => {
          if (!dragging) return;
          const dx = event.clientX - startX;
          const dy = event.clientY - startY;
          if (Math.abs(dx) + Math.abs(dy) > 3) moved = true;
          tx = baseX + dx;
          ty = baseY + dy;
          paint();
        });

        const stopDrag = () => {
          if (!dragging) return;
          dragging = false;
          paint();
        };
        overlay.addEventListener("pointerup", stopDrag);
        overlay.addEventListener("pointercancel", stopDrag);

        // 手机上左右滑翻页（只在未放大时）
        overlay.addEventListener(
          "touchstart",
          (event) => {
            if (event.touches.length !== 1) return;
            touchX = event.touches[0].clientX;
            touchY = event.touches[0].clientY;
          },
          { passive: true }
        );

        overlay.addEventListener(
          "touchend",
          (event) => {
            if (scale > 1 || items.length < 2) return;
            const touch = event.changedTouches[0];
            if (!touch) return;
            const dx = touch.clientX - touchX;
            const dy = touch.clientY - touchY;
            if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
              show(index + (dx < 0 ? 1 : -1));
            }
          },
          { passive: true }
        );
      }

      article.addEventListener("click", (event) => {
        const img = (event.target as HTMLElement).closest("img");
        if (!img) return;
        // 太小的图（表情、图标）放大没意义
        if (Number(img.getAttribute("width") ?? 0) < 200 && img.naturalWidth < 200) return;
        const list = collect();
        const src = img.currentSrc || img.src;
        const start = list.findIndex((item) => item.src === src);
        event.preventDefault();
        openAt(list, start < 0 ? 0 : start);
      });

      document.addEventListener("keydown", (event) => {
        if (!overlay) return;
        if (event.key === "Escape") close();
        else if (event.key === "ArrowLeft") show(index - 1);
        else if (event.key === "ArrowRight") show(index + 1);
        else if (event.key === "+" || event.key === "=") {
          scale = Math.min(MAX_SCALE, scale * 1.25);
          paint();
        } else if (event.key === "-") {
          scale = Math.max(1, scale / 1.25);
          if (scale === 1) {
            tx = 0;
            ty = 0;
          }
          paint();
        }
      });
    }

    /* ---------- 分享 ---------- */
    /* ---------- 阅读进度 + 目录跟随 ---------- */

    function setupReading() {
      const article = document.querySelector<HTMLElement>("article");
      const bar = document.getElementById("read-progress-bar");
      if (!article || !bar) return;

      const toc = document.getElementById("toc");
      const marker = toc?.querySelector<HTMLElement>(".toc-marker") ?? null;
      const pairs = toc
        ? Array.from(toc.querySelectorAll<HTMLAnchorElement>("a[data-target]"))
            .map((a) => ({
              a,
              h: document.getElementById(a.dataset.target ?? ""),
            }))
            .filter((p): p is { a: HTMLAnchorElement; h: HTMLElement } => !!p.h)
        : [];

      // 固定页头会盖住锚点标题，这个位移既是判定线，也和 CSS 的 scroll-margin-top 对齐
      const OFFSET = 96;
      let active = -1;

      function paint() {
        // 先读完所有几何信息，再统一写样式，避免同一帧里强制重排多次
        const scrollY = window.scrollY;
        const vh = window.innerHeight;
        const rect = article.getBoundingClientRect();
        const passed = unitsPassed();
        const maxScroll = document.documentElement.scrollHeight - vh;
        const atBottom = scrollY >= maxScroll - 8;

        // 从「正文顶端越过判定线」开始计，到页面滚到底正好满格。
        // 终点取可滚动范围的底部而不是正文底部：正文后面还有分享、上下篇和页脚，
        // 若按正文底部算，文章一读完进度条就满了，最后一段完全没反馈。
        const startY = rect.top + scrollY - OFFSET;
        const endY = maxScroll;
        let p: number;
        if (endY - startY <= 0) p = scrollY >= startY ? 1 : 0;
        else p = (scrollY - startY) / (endY - startY);
        if (p < 0) p = 0;
        if (p > 1) p = 1;
        bar.style.transform = `scaleX(${p})`;

        if (!pairs.length) return;

        let idx = -1;
        for (let i = 0; i < passed.length; i += 1) {
          if (passed[i]) idx = i;
          else break;
        }
        // 刚进正文还没读到第一节时，先认第一节，免得整段都没有落点
        if (idx < 0 && rect.top <= OFFSET) idx = 0;
        // 末节太短，滚到底也越不过判定线，到底就点亮最后一节
        if (atBottom) idx = pairs.length - 1;
        if (idx === active) return;
        active = idx;

        pairs.forEach(({ a }, i) => {
          a.classList.toggle("is-active", i === idx);
          if (i === idx) a.setAttribute("aria-current", "location");
          else a.removeAttribute("aria-current");
        });

        const cur = pairs[idx]?.a;
        if (!marker) return;
        if (!cur) {
          marker.style.opacity = "0";
          return;
        }
        marker.style.opacity = "1";
        marker.style.height = `${cur.offsetHeight}px`;
        marker.style.transform = `translateY(${cur.offsetTop}px)`;
      }

      // 只读一次：哪些标题已经越过判定线
      function unitsPassed() {
        const out: boolean[] = [];
        for (const { h } of pairs) {
          out.push(h.getBoundingClientRect().top <= OFFSET);
        }
        return out;
      }

      let ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          paint();
        });
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      // 图片、字体加载完正文高度会变，收尾再校准一次
      window.addEventListener("load", paint);
      paint();
    }

    function boot() {
      enhanceCodeBlocks();
      setupLightbox();
      setupShare();
      setupReading();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }
  </script>
</Base>
