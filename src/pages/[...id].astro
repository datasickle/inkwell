---
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import FormattedDate from "../components/FormattedDate.astro";
import BackToPrev from "../components/BackToPrev.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { readingTime } from "../lib/format";
import { groupByTag } from "../lib/tags";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  // 与 /tags 共用同一份标签排序，锚点才对得上
  const { anchorOf } = groupByTag(posts);
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      tagAnchors: anchorOf,
      // 列表是「新 → 旧」，所以 i-1 是时间上更新的一篇，i+1 是更早的一篇
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  tagAnchors: Record<string, string>;
  newer: CollectionEntry<"blog"> | null;
  older: CollectionEntry<"blog"> | null;
}

const { post, tagAnchors, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, date, tags, summary } = post.data;

// 只取二三级标题；少于 2 条就不显示，免得短文的目录占地方
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base title={title} description={summary} type="article">
  {/* 阅读进度条：固定在页头之上，宽度由脚本按正文进度缩放 */}
  <div class="read-progress" aria-hidden="true">
    <span id="read-progress-bar"></span>
  </div>

  <Container>
    <div class="animate">
      <BackToPrev href="/">全部文章</BackToPrev>
    </div>

    <div class="my-10 space-y-1">
      <div class="animate flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm">
        <FormattedDate date={date} />
        <span class="opacity-40">{"/"}</span>
        <span>{readingTime(post.body)} 分钟</span>
        {
          tags.length > 0 && (
            <>
              <span class="opacity-40">{"/"}</span>
              <span class="flex flex-wrap items-center gap-x-1.5 opacity-70">
                {tags.map((tag, i) => (
                  <>
                    {i > 0 && <span class="opacity-40">{"/"}</span>}
                    <a
                      href={`/tags#${tagAnchors[tag] ?? ""}`}
                      class="transition-colors duration-300 hover:text-black hover:opacity-100 dark:hover:text-white"
                    >
                      {tag}
                    </a>
                  </>
                ))}
              </span>
            </>
          )
        }
      </div>
      <h1 class="animate text-2xl sm:text-3xl font-semibold leading-snug text-black dark:text-white">
        {title}
      </h1>
    </div>

    {
      toc.length >= 2 && (
        <>
          <nav
            id="toc"
            aria-label="目录"
            class="animate toc relative mb-10 space-y-2 border-l-2 border-black/10 pl-4 text-sm dark:border-white/15"
          >
            {/* 跟随高亮的滑块，位置由脚本按当前小节移动 */}
            <span class="toc-marker" aria-hidden="true" />
            {toc.map((h) => (
              <a
                href={`#${h.slug}`}
                data-target={h.slug}
                class:list={[
                  "toc-link block leading-snug opacity-70 transition-colors duration-300 hover:text-black hover:opacity-100 dark:hover:text-white",
                  h.depth === 3 && "pl-4 text-[13px] opacity-55",
                ]}
              >
                {h.text}
              </a>
            ))}
          </nav>
          {/* 宽屏时目录被抽到右侧固定，用它补回原来的间距 */}
          <div class="toc-gap" aria-hidden="true" />
        </>
      )
    }

    <article class="animate">
      <Content />
    </article>

    {/*
      分享按钮先渲染成 hidden，由脚本判断能力后再显示：
      没有 JS 的环境不该出现一个点了没反应的按钮。
    */}
    <div class="animate mt-12 flex flex-wrap items-center gap-x-3 gap-y-2">
      <button type="button" id="share-btn" class="share-btn" hidden>
        <svg
          viewBox="0 0 24 24"
          class="size-4 fill-none stroke-current"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 13v6a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-6"></path>
          <polyline points="16 7 12 3 8 7"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
        <span id="share-label">分享</span>
      </button>
      <span
        id="share-tip"
        class="text-xs opacity-0 transition-opacity duration-300"
        role="status"
        aria-live="polite"></span>
    </div>

    {
      (older || newer) && (
        <nav
          aria-label="上下篇"
          class="animate mt-10 grid gap-2 border-t border-black/10 pt-8 sm:grid-cols-2 dark:border-white/15"
        >
          {older && (
            <a
              href={`/${older.id}/`}
              class="group -mx-3 rounded-lg px-3 py-3 transition-colors duration-300 hover:bg-black/5 dark:hover:bg-white/5 sm:col-start-1"
            >
              <span class="flex items-center gap-1.5 text-xs opacity-50">
                <span aria-hidden="true">←</span> 上一篇
              </span>
              <span class="mt-1.5 block text-sm font-medium leading-snug text-black/75 transition-colors group-hover:text-black dark:text-white/75 dark:group-hover:text-white">
                {older.data.title}
              </span>
              <span class="mt-1 block text-xs opacity-40">
                <FormattedDate date={older.data.date} />
              </span>
            </a>
          )}
          {newer && (
            <a
              href={`/${newer.id}/`}
              class="group -mx-3 rounded-lg px-3 py-3 transition-colors duration-300 hover:bg-black/5 dark:hover:bg-white/5 sm:col-start-2 sm:text-right"
            >
              <span class="flex items-center gap-1.5 text-xs opacity-50 sm:justify-end">
                下一篇 <span aria-hidden="true">→</span>
              </span>
              <span class="mt-1.5 block text-sm font-medium leading-snug text-black/75 transition-colors group-hover:text-black dark:text-white/75 dark:group-hover:text-white">
                {newer.data.title}
              </span>
              <span class="mt-1 block text-xs opacity-40">
                <FormattedDate date={newer.data.date} />
              </span>
            </a>
          )}
        </nav>
      )
    }
  </Container>

  {/*
    两处渐进增强，都用原生 DOM 实现，不引任何库：
    1) 给每个 <pre> 套一层容器并加“复制”按钮，JS 不跑就只是没有按钮，代码块本身照旧
    2) 点正文图片放大查看，Esc 或点任意处关闭
  */}
  <script>
    /* ---------- 代码块复制 ---------- */

    async function copyText(text: string) {
      // 优先用异步剪贴板 API。注意它可能「存在但被拒」：
      // 页面未聚焦、权限被策略拦、部分浏览器隐私模式下都会 reject，
      // 所以必须 try 一次再降级，不能只判断 API 存不存在。
      if (navigator.clipboard && window.isSecureContext) {
        try {
          await navigator.clipboard.writeText(text);
          return;
        } catch {
          /* 落到下面的兜底 */
        }
      }
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.cssText = "position:fixed;top:0;left:-9999px;opacity:0";
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try {
        ok = document.execCommand("copy");
      } finally {
        document.body.removeChild(ta);
      }
      if (!ok) throw new Error("copy failed");
    }

    function enhanceCodeBlocks() {
      document.querySelectorAll<HTMLPreElement>("article pre").forEach((pre) => {
        // 已经处理过就跳过，避免重复插入按钮
        if (pre.parentElement?.classList.contains("code-block")) return;

        const box = document.createElement("div");
        box.className = "code-block";
        pre.replaceWith(box);
        box.appendChild(pre);

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "code-copy";
        btn.textContent = "复制";
        btn.setAttribute("aria-label", "复制这段代码");

        let timer = 0;
        btn.addEventListener("click", async () => {
          const code = pre.querySelector("code")?.innerText ?? pre.innerText;
          try {
            await copyText(code.replace(/\n$/, ""));
            btn.textContent = "已复制";
            btn.classList.add("done");
          } catch {
            btn.textContent = "失败";
          }
          clearTimeout(timer);
          timer = window.setTimeout(() => {
            btn.textContent = "复制";
            btn.classList.remove("done");
          }, 1600);
        });

        box.appendChild(btn);
      });
    }

    /* ---------- 图片放大 ---------- */

    function setupLightbox() {
      const article = document.querySelector("article");
      if (!article) return;

      let overlay: HTMLDivElement | null = null;
      let scrollY = 0;

      function close() {
        if (!overlay) return;
        overlay.classList.remove("on");
        document.documentElement.classList.remove("lightbox-open");
        document.body.style.top = "";
        window.scrollTo(0, scrollY);
        const dying = overlay;
        overlay = null;
        window.setTimeout(() => dying.remove(), 220);
      }

      function open(src: string, alt: string) {
        if (overlay) return;
        scrollY = window.scrollY;

        overlay = document.createElement("div");
        overlay.className = "lightbox";
        overlay.setAttribute("role", "dialog");
        overlay.setAttribute("aria-modal", "true");
        overlay.setAttribute("aria-label", alt || "图片预览");

        const img = document.createElement("img");
        img.src = src;
        img.alt = alt;
        overlay.appendChild(img);

        // 点背景或图片本身都关闭
        overlay.addEventListener("click", close);
        document.body.appendChild(overlay);
        // 下一帧再加 .on，否则不会触发过渡
        requestAnimationFrame(() => overlay?.classList.add("on"));

        // 锁滚动：fixed + 负 top 保持视觉位置不跳
        document.documentElement.classList.add("lightbox-open");
        document.body.style.top = `-${scrollY}px`;
      }

      article.addEventListener("click", (e) => {
        const img = (e.target as HTMLElement).closest("img");
        if (!img) return;
        // 太小的图（表情、图标）放大没意义
        if (img.naturalWidth < 200) return;
        e.preventDefault();
        open(img.currentSrc || img.src, img.alt);
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });
    }

    /* ---------- 分享 ---------- */

    function setupShare() {
      const btn = document.getElementById("share-btn");
      const label = document.getElementById("share-label");
      const tip = document.getElementById("share-tip");
      if (!btn || !label || !tip) return;

      const title = document.title;
      // 当前文章地址。带上已有的 location.href 是为了保住可能存在的锚点
      const url = window.location.href;
      // 桌面 Chrome 也有 navigator.share，但点下去弹的是 Windows 系统分享面板，
      // 对"复制个链接"来说反而绕。所以只在触屏设备上用系统分享。
      const isTouch = window.matchMedia("(hover: none) and (pointer: coarse)").matches;
      const canNative = typeof navigator.share === "function" && isTouch;

      // 有系统分享（手机）就说「分享」，否则老实写「复制链接」，
      // 不然点下去什么面板都不弹，会以为坏了。
      label.textContent = canNative ? "分享" : "复制链接";
      btn.hidden = false;

      let timer = 0;
      function flash(text: string) {
        tip.textContent = text;
        tip.style.opacity = "1";
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          tip.style.opacity = "0";
        }, 2000);
      }

      btn.addEventListener("click", async () => {
        if (canNative) {
          try {
            await navigator.share({ title, text: title, url });
            return;
          } catch (err) {
            // 用户自己取消，什么都不做；
            // 其它失败（比如页面没聚焦、被策略拦）继续走复制，别让按钮白点
            if ((err as DOMException)?.name === "AbortError") return;
          }
        }
        try {
          await copyText(url);
          flash("链接已复制");
        } catch {
          flash("复制失败，请手动复制地址栏");
        }
      });
    }

    /* ---------- 阅读进度 + 目录跟随 ---------- */

    function setupReading() {
      const article = document.querySelector<HTMLElement>("article");
      const bar = document.getElementById("read-progress-bar");
      if (!article || !bar) return;

      const toc = document.getElementById("toc");
      const marker = toc?.querySelector<HTMLElement>(".toc-marker") ?? null;
      const pairs = toc
        ? Array.from(toc.querySelectorAll<HTMLAnchorElement>("a[data-target]"))
            .map((a) => ({
              a,
              h: document.getElementById(a.dataset.target ?? ""),
            }))
            .filter((p): p is { a: HTMLAnchorElement; h: HTMLElement } => !!p.h)
        : [];

      // 固定页头会盖住锚点标题，这个位移既是判定线，也和 CSS 的 scroll-margin-top 对齐
      const OFFSET = 96;
      let active = -1;

      function paint() {
        // 先读完所有几何信息，再统一写样式，避免同一帧里强制重排多次
        const scrollY = window.scrollY;
        const vh = window.innerHeight;
        const rect = article.getBoundingClientRect();
        const passed = unitsPassed();
        const maxScroll = document.documentElement.scrollHeight - vh;
        const atBottom = scrollY >= maxScroll - 8;

        // 从「正文顶端越过判定线」开始计，到页面滚到底正好满格。
        // 终点取可滚动范围的底部而不是正文底部：正文后面还有分享、上下篇和页脚，
        // 若按正文底部算，文章一读完进度条就满了，最后一段完全没反馈。
        const startY = rect.top + scrollY - OFFSET;
        const endY = maxScroll;
        let p: number;
        if (endY - startY <= 0) p = scrollY >= startY ? 1 : 0;
        else p = (scrollY - startY) / (endY - startY);
        if (p < 0) p = 0;
        if (p > 1) p = 1;
        bar.style.transform = `scaleX(${p})`;

        if (!pairs.length) return;

        let idx = -1;
        for (let i = 0; i < passed.length; i += 1) {
          if (passed[i]) idx = i;
          else break;
        }
        // 刚进正文还没读到第一节时，先认第一节，免得整段都没有落点
        if (idx < 0 && rect.top <= OFFSET) idx = 0;
        // 末节太短，滚到底也越不过判定线，到底就点亮最后一节
        if (atBottom) idx = pairs.length - 1;
        if (idx === active) return;
        active = idx;

        pairs.forEach(({ a }, i) => {
          a.classList.toggle("is-active", i === idx);
          if (i === idx) a.setAttribute("aria-current", "location");
          else a.removeAttribute("aria-current");
        });

        const cur = pairs[idx]?.a;
        if (!marker) return;
        if (!cur) {
          marker.style.opacity = "0";
          return;
        }
        marker.style.opacity = "1";
        marker.style.height = `${cur.offsetHeight}px`;
        marker.style.transform = `translateY(${cur.offsetTop}px)`;
      }

      // 只读一次：哪些标题已经越过判定线
      function unitsPassed() {
        const out: boolean[] = [];
        for (const { h } of pairs) {
          out.push(h.getBoundingClientRect().top <= OFFSET);
        }
        return out;
      }

      let ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          paint();
        });
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      // 图片、字体加载完正文高度会变，收尾再校准一次
      window.addEventListener("load", paint);
      paint();
    }

    function boot() {
      enhanceCodeBlocks();
      setupLightbox();
      setupShare();
      setupReading();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }
  </script>
</Base>
