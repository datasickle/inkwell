---
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import Link from "../components/Link.astro";
---

<Base title="页面不存在">
  <Container>
    <div class="animate space-y-8 py-16">
      <p
        class="text-6xl font-semibold tracking-tight text-black/10 dark:text-white/10"
      >
        404
      </p>
      <div class="space-y-2">
        <h1 class="text-2xl font-semibold text-black dark:text-white">
          这里什么都没有
        </h1>
        <p class="text-sm">
          链接可能写错了，或者这篇文章已经被删掉了。
        </p>
      </div>
      <Link href="/" class="text-sm">← 回首页</Link>
    </div>
  </Container>
</Base>
