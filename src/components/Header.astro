---
import Container from "./Container.astro";
import Link from "./Link.astro";
import site from "../../site.json";
---

<header>
  <Container>
    <div class="flex flex-wrap gap-x-4 gap-y-2 justify-between items-baseline">
      <Link href="/" underline={false}>
        <span class="font-semibold text-[15px] sm:text-base">{site.title}</span>
      </Link>
      <nav class="flex flex-wrap gap-1 text-[13px] sm:text-sm">
        <Link href="/">文章</Link>
        <span class="opacity-40" aria-hidden="true">{"/"}</span>
        <Link href="/notes/">{site.notesLabel}</Link>
        <span class="opacity-40" aria-hidden="true">{"/"}</span>
        <Link href="/tags/">标签</Link>
        <span class="opacity-40" aria-hidden="true">{"/"}</span>
        <Link href="/archive/">归档</Link>
        <span class="opacity-40" aria-hidden="true">{"/"}</span>
        <Link href="/search/">搜索</Link>
        <span class="opacity-40" aria-hidden="true">{"/"}</span>
        <Link href="/about/">关于</Link>
        <span class="opacity-40" aria-hidden="true">{"/"}</span>
        <Link href="/rss.xml">rss</Link>
      </nav>
    </div>
  </Container>
</header>
