---
import site from "../../site.json";

interface Props {
  title?: string;
  description?: string;
  type?: string;
  /** 分享卡路径，站内绝对路径。文章页传 /og/<id>.png，其余走全站默认卡 */
  ogImage?: string;
  /** 发布时间（ISO）。只有文章页会传 */
  publishedTime?: string;
  /** 有修订时间再传；没有就沿用发布时间 */
  updatedTime?: string;
  tags?: string[];
}

const {
  title,
  description,
  type = "website",
  ogImage,
  publishedTime,
  updatedTime,
  tags = [],
} = Astro.props;

const pageTitle = title ? `${title} — ${site.title}` : site.title;
const pageDesc = description || site.description;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

// 分享卡必须是绝对地址，且必须是位图：SVG 微信、Twitter、Facebook 都不认。
// 全站默认卡由 tools/make-og.py 生成；文章页有配图时用构建期裁的 /og/<id>.png。
const base = Astro.site ?? Astro.url;
const ogImageUrl = new URL(ogImage ?? "/og.png", base).href;
const origin = base.href.replace(/\/$/, "");

// 结构化数据：文章页给 BlogPosting，其余给 WebSite。
// 关掉 < 是为了不提前闭合 script 标签。
const jsonLd =
  type === "article" && publishedTime
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description: pageDesc,
        image: [ogImageUrl],
        datePublished: publishedTime,
        dateModified: updatedTime || publishedTime,
        inLanguage: site.lang,
        author: { "@type": "Person", name: site.author, url: origin },
        publisher: { "@type": "Person", name: site.author, url: origin },
        mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
        ...(tags.length ? { keywords: tags.join(",") } : {}),
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: site.title,
        url: origin,
        description: pageDesc,
        inLanguage: site.lang,
        author: { "@type": "Person", name: site.author },
      };
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light dark" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title={site.title} href={new URL("/rss.xml", Astro.site ?? Astro.url)} />

<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={pageDesc} />
<meta name="author" content={site.author} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDesc} />
<meta property="og:site_name" content={site.title} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={pageTitle} />
<meta property="og:locale" content="zh_CN" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDesc} />
<meta name="twitter:image" content={ogImageUrl} />

{
  publishedTime && (
    <>
      <meta property="article:published_time" content={publishedTime} />
      <meta property="article:modified_time" content={updatedTime || publishedTime} />
      <meta property="article:author" content={site.author} />
      {tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<script type="application/ld+json" is:inline set:html={jsonLdText} />

<!--
  主题切换。内联在 head 里，是为了在首次绘制之前就把 dark 类加上，
  否则深色模式用户每次打开都会看到一瞬白屏。逻辑本身照搬 Astro Nano。
-->
<script is:inline>
  (function () {
    var KEY = "theme";

    function prefersDark() {
      return window.matchMedia("(prefers-color-scheme: dark)").matches;
    }

    function apply(dark) {
      var root = document.documentElement;

      // 切换瞬间临时禁用所有过渡，否则整页元素会一起做颜色动画，很脏
      var css = document.createElement("style");
      css.textContent = "*,*::before,*::after{transition:none !important}";
      document.head.appendChild(css);

      root.classList.toggle("dark", dark);

      // 读一次样式强制回流，再移除，改动才会立刻生效
      void window.getComputedStyle(css).opacity;
      document.head.removeChild(css);
    }

    function stored() {
      var v = null;
      try {
        v = localStorage.getItem(KEY);
      } catch (e) {}
      if (v === "dark") return true;
      if (v === "light") return false;
      return prefersDark();
    }

    function save(value) {
      try {
        localStorage.setItem(KEY, value);
      } catch (e) {}
    }

    function onScroll() {
      document.documentElement.classList.toggle("scrolled", window.scrollY > 0);
    }

    // 先上色，后绑定
    apply(stored());

    // 阅读偏好（字号 / 行距 / 字体）：同样在绘制前落到 <html> 上，
    // 否则设过「大字号」的人打开每一页都会先看到默认字号再跳一下。
    (function () {
      var defaults = { size: "m", leading: "normal", font: "sans" };
      var keys = ["size", "leading", "font"];
      var saved = {};
      try {
        saved = JSON.parse(localStorage.getItem("reading") || "{}") || {};
      } catch (e) {}
      var target = document.documentElement;
      for (var i = 0; i < keys.length; i++) {
        var key = keys[i];
        var value = typeof saved[key] === "string" ? saved[key] : defaults[key];
        target.setAttribute("data-read-" + key, value);
      }
    })();

    function init() {
      var light = document.getElementById("light-theme-button");
      var darkBtn = document.getElementById("dark-theme-button");
      var system = document.getElementById("system-theme-button");

      if (light) {
        light.addEventListener("click", function () {
          save("light");
          apply(false);
        });
      }
      if (darkBtn) {
        darkBtn.addEventListener("click", function () {
          save("dark");
          apply(true);
        });
      }
      if (system) {
        system.addEventListener("click", function () {
          save("system");
          apply(prefersDark());
        });
      }

      var mq = window.matchMedia("(prefers-color-scheme: dark)");
      if (mq.addEventListener) {
        mq.addEventListener("change", function (e) {
          var v = null;
          try {
            v = localStorage.getItem(KEY);
          } catch (err) {}
          if (!v || v === "system") apply(e.matches);
        });
      }

      var backToTop = document.getElementById("back-to-top");
      if (backToTop) {
        backToTop.addEventListener("click", function (e) {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      }

      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
