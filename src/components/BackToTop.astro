---
// 圆形图标按钮：手机上页脚空间紧张，长条「回到顶部」太占地方
---
<button
  id="back-to-top"
  type="button"
  aria-label="回到顶部"
  title="回到顶部"
  class="group flex size-10 items-center justify-center rounded-full border border-black/15 text-current transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="size-4 rotate-90 stroke-2 fill-none stroke-current transition-transform duration-300 ease-in-out group-hover:-translate-y-0.5"
  >
    <polyline points="12 5 5 12 12 19" />
  </svg>
</button>
