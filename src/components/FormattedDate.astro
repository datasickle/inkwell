---
import { fmtFull, fmtShort, isoZoned } from "../lib/datetime";

interface Props {
  date: Date;
  /** full：2026/11/23 20:14:07；short：11/23 20:14 */
  variant?: "full" | "short";
  class?: string;
}

const { date, variant = "full", class: className } = Astro.props;
---

<time datetime={isoZoned(date)} class={className}>
  {variant === "short" ? fmtShort(date) : fmtFull(date)}
</time>
