---
interface Props {
  href: string;
  external?: boolean;
  underline?: boolean;
  class?: string;
  ariaCurrent?: "page" | "true" | undefined;
}

const { href, external, underline = true, class: className, ariaCurrent } = Astro.props;

const base =
  "inline-block decoration-black/15 dark:decoration-white/30 " +
  "hover:decoration-black/25 hover:dark:decoration-white/50 " +
  "text-current hover:text-black hover:dark:text-white " +
  "transition-colors duration-300 ease-in-out";
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  rel={external ? "noopener noreferrer" : undefined}
  aria-current={ariaCurrent}
  class:list={[base, underline && "underline underline-offset-2", className]}
>
  <slot />
</a>
