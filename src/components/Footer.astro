---
import Container from "./Container.astro";
import BackToTop from "./BackToTop.astro";
import ReadingPrefs from "./ReadingPrefs.astro";
import site from "../../site.json";
import { yearOf } from "../lib/datetime";

// 走 datetime.ts 折算东八区：构建机在 UTC，元旦那 8 小时里 getFullYear() 会少一年
const year = yearOf(new Date());

interface Props {
  // 只在文章页显示阅读偏好入口：字号行距字体只作用于正文
  showReadingPrefs?: boolean;
}

const { showReadingPrefs = false } = Astro.props;
---

<footer class="animate">
  <Container>
    <div class="relative">
      <div class="absolute right-0 -top-20">
        <BackToTop />
      </div>
    </div>
    <div class="flex justify-between items-center text-sm">
      <div class="truncate">
        &copy; {year} {site.author}
      </div>
      <div class="flex flex-wrap gap-1 items-center">
        {showReadingPrefs && (
          <>
            <ReadingPrefs />
            <span class="mx-1 h-4 w-px bg-black/10 dark:bg-white/15" aria-hidden="true"></span>
          </>
        )}
        <button
          id="theme-toggle"
          type="button"
          aria-label="切换浅色/深色主题"
          title="切到深色"
          class="group size-8 flex items-center justify-center rounded-full"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="theme-icon theme-icon-light group-hover:stroke-black group-hover:dark:stroke-white transition-colors duration-300 ease-in-out"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="theme-icon theme-icon-dark group-hover:stroke-black group-hover:dark:stroke-white transition-colors duration-300 ease-in-out"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
        <button
          id="theme-system-button"
          type="button"
          aria-label="跟随系统"
          aria-pressed="false"
          title="跟随系统，点击切换"
          class="theme-system group size-8 flex items-center justify-center rounded-full"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="group-hover:stroke-black group-hover:dark:stroke-white transition-colors duration-300 ease-in-out"
          >
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </button>
        <a
          href="/rss.xml"
          aria-label="RSS 订阅"
          title="RSS 订阅"
          class="group size-8 flex items-center justify-center rounded-full text-current hover:text-black hover:dark:text-white transition-colors duration-300 ease-in-out"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
        </a>
      </div>
    </div>
  </Container>
</footer>
