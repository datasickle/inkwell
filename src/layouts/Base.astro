---
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import site from "../../site.json";

interface Props {
  title?: string;
  description?: string;
  type?: string;
  ogImage?: string;
  publishedTime?: string;
  updatedTime?: string;
  tags?: string[];
  // 阅读偏好（字号/行距/字体）只影响正文，所以只在文章页放出入口
  readingPrefs?: boolean;
}

// readingPrefs 是布局自己的开关，不转交给 Head；
// 其余字段原样转交：页面只需要关心「这篇是什么」，不关心 meta 怎么拼
const { readingPrefs = false, ...headProps } = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <Head {...headProps} />
    <!--
      站内跳转不再整页重载：浏览器不转刷新按钮、不重播 favicon、不闪白屏。
      带状态迁移的脚本要自己处理「换页后重新初始化」，见 src/lib/nav-cleanup.ts。
    -->
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer showReadingPrefs={readingPrefs} />
    <script>
      // 绑定一次即可：文档不卸载，这段脚本也只会跟着首个页面执行
      import { resetOnNavigate } from "../lib/nav-cleanup";
      import { setupLightbox, closeLightbox } from "../lib/lightbox";
      const flag = "__navCleanupBound";
      if (!(window as unknown as Record<string, boolean>)[flag]) {
        (window as unknown as Record<string, boolean>)[flag] = true;
        document.addEventListener("astro:before-swap", () => {
          closeLightbox();
          resetOnNavigate();
        });
      }
      // 图片放大是文档级委托，绑一次就够；放在这里，文章页和碎片页都生效
      setupLightbox();
    </script>
  </body>
</html>
