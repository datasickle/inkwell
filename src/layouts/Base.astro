---
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import site from "../../site.json";

interface Props {
  title?: string;
  description?: string;
  type?: string;
  ogImage?: string;
  publishedTime?: string;
  updatedTime?: string;
  tags?: string[];
}

// 原样转交给 Head：页面只需要关心「这篇是什么」，不关心 meta 怎么拼
const props = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <Head {...props} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
